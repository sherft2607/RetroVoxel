{
  "plugin_name": "RetroVoxel",
  "plugin_prefix": "RVX",
  "resources_path": "Icons",
  "resx_path": "Properties/Resources.resx",

  "defaults": {
    "size": 24,
    "fg_color": "#FFFFFF",
    "background": {
      "shape": {
        "type": "rounded-square",
        "gradient": { "from": "#7B2FF7", "to": "#E8437A", "angle": 135 }
      }
    }
  },

